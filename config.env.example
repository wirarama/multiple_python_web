# Konfigurasi layanan - disalin otomatis ke config.env oleh setup.sh.
# config.env tidak ikut di-commit (lihat .gitignore), jadi aman diubah per server.

# Alamat bind: 0.0.0.0 = bisa diakses dari luar; 127.0.0.1 = hanya lokal (pakai bila di belakang nginx)
HOST=0.0.0.0

# Portal gabungan (SDN, Smart Home, RL-FL, PySpark) dijalankan gunicorn
PORTAL_PORT=8000
# Wajib 1 worker: aplikasi menyimpan state simulasi di memori proses.
# Permintaan paralel ditangani oleh thread.
PORTAL_THREADS=8
# Batas waktu satu permintaan (detik) - pelatihan RL/FL bisa lama
PORTAL_TIMEOUT=300
# Batasi aplikasi yang dimuat (kosong = semua). Contoh: MPW_APPS=sdn,pyspark
MPW_APPS=
# Tombol kecil "Portal" di pojok kiri bawah setiap aplikasi (1 = tampil, 0 = sembunyi)
MPW_PORTAL_BADGE=1

# Data Mining UI (Streamlit, proses terpisah)
ENABLE_DATAMINING=1
STREAMLIT_PORT=8501
STREAMLIT_BASE_PATH=datamining
# URL yang dipakai tombol "Buka" di portal. Kosong = http://<host-yang-sama>:STREAMLIT_PORT/STREAMLIT_BASE_PATH/
# Bila memakai nginx (deploy/nginx.conf.example) isi dengan: /datamining/
DATAMINING_URL=

# Lokasi database SQLite Smart Home (kosong = apps/smarthome/instance/smarthome.db)
#SMARTHOME_DB=/var/lib/mpw/smarthome.db
